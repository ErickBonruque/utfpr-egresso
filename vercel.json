{
  "version": 2,
  "builds": [
    {
      "src": "start.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "start.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "utfpr_egresso.settings_production",
    "VERCEL": "1"
  }
}
