# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://cea:cea_dev_password@localhost:5432/cea"

# Só em Postgres gerenciado com pooler (Neon, Fase 10): a aplicação usa a
# DATABASE_URL *com pool* e as migrations usam esta, *direta* — o pooler em
# modo transaction não suporta o advisory lock do `prisma migrate`.
# DIRECT_URL="postgresql://...@ep-xxx.sa-east-1.aws.neon.tech/cea?sslmode=require"

# Better Auth (Fase 3) — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Seed: credenciais do primeiro SUPER_ADMIN (defaults de dev)
# SEED_SUPERADMIN_EMAIL="admin@cea.local"
# SEED_SUPERADMIN_PASSWORD="@admin123"

# Adzuna (Fase 6.1 — busca de vagas): cadastre em https://developer.adzuna.com
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""

# Fonte de vagas: "auto" (padrão) | "adzuna" | "demo".
#   auto   — tenta a Adzuna e, se ela falhar (sem chave, rede, cota, 5xx),
#            cai em vagas sintéticas com aviso visível na tela. É o que
#            garante que uma apresentação não quebre por API de terceiro.
#   adzuna — só a fonte real; falha aparece como erro (bom para diagnosticar).
#   demo   — só dados sintéticos, sem chamada externa.
# JOBS_PROVIDER="auto"

# Integração acadêmica (Fase 8) — de onde vêm situação, matrículas e notas.
# "seed" (padrão): dados sintéticos determinísticos, gerados da matriz
# curricular. "utfpr": conexão real (ver decisions/FASE_8_INTEGRACAO_UTFPR.md).
# ACADEMIC_PROVIDER="seed"

# Só para ACADEMIC_PROVIDER="utfpr": usuário SÓ-LEITURA nas views acadêmicas.
# Os nomes das views só precisam ser definidos se diferirem do padrão.
# UTFPR_DATABASE_URL="postgresql://usuario_leitura:senha@host:5432/academico"
# UTFPR_STUDENT_VIEW="cea_aluno"
# UTFPR_ENROLLMENT_VIEW="cea_matricula"

# Prisma: banco descartável usado só por `prisma migrate diff` (Fase 7).
# SHADOW_DATABASE_URL="postgresql://cea:cea_dev_password@localhost:5432/cea_shadow"

# Logs estruturados (Fase 9): debug|info|warn|error. Default: debug em dev,
# info em produção. Uma linha JSON por evento quando NODE_ENV=production.
# LOG_LEVEL="info"

# Fase 9 — o boot confere estas variáveis (src/lib/env-check.ts). Em produção,
# BETTER_AUTH_SECRET ausente/curto/igual ao exemplo DERRUBA a subida: sessão
# assinada com segredo público é forjável. Gere com: openssl rand -base64 32

# Identidade do ambiente (Fase 10): "demo" | "producao". Sem valor, o sistema
# deduz do NODE_ENV. "demo" liga a faixa de aviso no topo — este deploy vai ao
# ar com os logins mockados do seed, e ninguém pode confundi-lo com o sistema
# oficial da UTFPR.
# CEA_ENVIRONMENT="demo"
